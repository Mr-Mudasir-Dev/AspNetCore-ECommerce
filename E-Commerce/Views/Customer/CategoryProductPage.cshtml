@{
    Layout = "~/Views/Shared/_Layout-User.cshtml";
}
@model List<Product>

 <div class="container-fluid product py-5">
    <div class="row g-4">
        <div class="col-lg-4 text-start wow fadeInLeft mb-2 text-center">
            <h1>@ViewBag.cat.Name Products</h1>
        </div>
    </div>
    <div class="container py-5">
        <div class="tab-class">
            <div class="tab-content">
                <div id="tab-1" class="tab-pane fade show p-0 active">
                    <div class="row g-4">
                        @foreach (var pro in Model)
                        {
                            <div class="col-md-6 col-lg-4 col-xl-3">
                                <div class="product-item rounded wow fadeInUp">
                                    <div class="product-item-inner border rounded">
                                        <div class="product-item-inner-item">
                                            <img src="~/Product-Image/@pro.ProductImg" class="img-fluid w-100 rounded-top" alt="">
                                            @if (pro.Stock > 0)
                                            {
                                                <div class="product-new">In Stock</div>
                                            }
                                            else
                                            {
                                                <div class="product-new bg-danger">Out of Stock</div>
                                            }
                                            <div class="product-details">
                                                <a href="@Url.Action("Product_Detail_Page", "Customer", new { id = pro.Id })"><i class="fa fa-eye fa-1x"></i></a>
                                            </div>
                                        </div>
                                        <div class="text-center rounded-bottom p-4">
                                            <a href="#" class="d-block mb-2">@pro.Category.Name</a>
                                            <a href="#" class="d-block h4">@pro.Name <br> @pro.Model</a>
                                            @if (pro.Price != null)
                                            {
                                                <span class="text-primary fs-5">@pro.Price?.ToString("N0") PKR </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="product-item-add border border-top-0 rounded-bottom text-center p-4 pt-0">
                                        <a href="@Url.Action("AddToCart", "Cart", new { pId = pro.Id })" class="btn btn-primary border-secondary rounded-pill py-2 px-4 mb-4">
                                            <i class="fas fa-shopping-cart me-2"></i> Add To Cart
                                        </a>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex">
                                                <a href="#" class="text-primary d-flex align-items-center justify-content-center me-3">
                                                    <span class="rounded-circle btn-sm-square border">
                                                        <i class="fas fa-random"></i>
                                                    </span>
                                                </a>
                                                <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0">
                                                    <span class="rounded-circle btn-sm-square border">
                                                        <i class="fas fa-heart"></i>
                                                    </span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>