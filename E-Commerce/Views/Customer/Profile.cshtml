@{
    Layout = "~/Views/Shared/_Layout-User.cshtml";
}
@model Customer


<div class="container-fluid contact py-5">
    @await Html.PartialAsync("User-Side/_Profile-Msg")
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-5 align-items-center">

                <!-- LEFT: USER IMAGE -->
                <div class="col-lg-4 text-center">
                    <div class="mb-4">
                        <img src="~/user/User-Image/@Model.Image"
                             class="img-fluid rounded-circle border border-4 border-primary"
                             style="width:220px;height:220px;object-fit:cover;">
                    </div>
                    <h3 class="mb-1">@Model.Name</h3>
                    <p class="text-muted">@Model.Email</p>
                </div>

                <!-- RIGHT: USER INFO -->
                <div class="col-lg-8">
                    <h2 class="mb-4 text-primary">Edit Profile</h2>

                    @await Html.PartialAsync("User-Side/_Customer-Profile-Edit-Form")

                </div>

            </div>
        </div>
    </div>
</div>



<div class="container-fluid contact py-3">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-5 align-items-center">

                <!-- RIGHT: USER INFO -->
                <div class="col-12">
                    <div class="p-4 rounded bg-white border">
                        <h4 class="text-primary mb-3">Change Password</h4>

                        <p class="text-muted mb-4">
                            If you want to change your password, please enter your current password first.
                            Make sure the current password is correct. Your new password must be different
                            from the current one and strong enough to keep your account secure.
                            Never share your password with anyone.
                        </p>

                        @await Html.PartialAsync("User-Side/_Customer-Password-Edit-Form")

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
