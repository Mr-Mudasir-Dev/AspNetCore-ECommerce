@{
    Layout = "~/Views/Shared/_Layout-User.cshtml";
}
@model Product

<div class="container-fluid product py-5">
    <div class="container py-5">
        <div class="p-5 bg-light rounded">
            <div class="row g-5 align-items-center">

                <!-- LEFT: PRODUCT IMAGE -->
                <div class="col-lg-5 text-center">
                    <img src="~/Product-Image/@Model.ProductImg"
                         class="img-fluid rounded border border-3"
                         style="max-height:420px;object-fit:contain;">
                </div>

                <!-- RIGHT: PRODUCT INFO -->
                <div class="col-lg-7">
                    <h2 class="mb-3">@Model.Name</h2>
                    <p class="text-muted mb-2">Model: <strong>@Model.Model</strong></p>

                    <h3 class="text-primary mb-3">
                        @Model.Price Pkr
                    </h3>

                    <p class="mb-3">
                        <strong>Category:</strong> @Model.Category.Name
                    </p>

                    <p class="mb-3">
                        <strong>Stock:</strong>
                        @if (Model.Stock > 0)
                        {
                            <span class="text-success">In Stock</span>
                        }
                        else
                        {
                            <span class="text-danger">Out of Stock</span>
                        }
                    </p>

                    <h5 class="mb-2">Product Description</h5>
                    <p class="text-muted">
                        @Model.Description
                    </p>

                    <div class="mt-4">
                        <a href="@Url.Action("AddToCart", "Cart", new { pId = Model.Id})" class="btn btn-primary btn-lg px-5">
                            Add to Cart
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

