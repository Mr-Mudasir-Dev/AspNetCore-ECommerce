@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form method="post" asp-action="Category_Edit">

    <div class="border rounded p-4">
        <h6 class="fw-bold mb-2">Edit Category</h6>

        <p class="text-muted mb-4">
            Category name should contain only letters (A–Z).
            Numbers and special characters are not allowed.
        </p>


        <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input type="text"
                   name="CategoryName"
                   value="@Model.Name"
                   class="form-control form-control-lg"
                   placeholder="Enter category name" />
            <span class="text-danger">@TempData["catnull"]</span>
            <span class="text-danger">@TempData["cat-old"]</span>
            <span class="text-danger">@TempData["caterror"]</span>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-control form-select form-control-lg">
                <option value="true" @(Model.Status == true? "selected" : "") class="text-success">Active</option>
                <option value="false" @(Model.Status == false? "selected" : "") class="text-danger">Non Active</option>
            </select>
        </div>


        <div class="d-grid mt-4">
            <button type="submit" class="btn btn-primary btn-lg">
                Update Category
            </button>
            <a href="@Url.Action("Category_All_Show","Admin")"
               class="btn btn-secondary btn-lg mt-3">
                Back
            </a>
        </div>
    </div>

</form>