@model List<Category>
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    int? selectedCat = TempData["CategoryId"] as int?;
}


<form method="post" enctype="multipart/form-data">



    <!-- Category & Name -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Category</label>
            <div class="input-group">
                <span class="input-group-text bg-dark text-white"><i class="fas fa-tags"></i></span>
                <select name="CategoryId" class="form-select">
                    <option value="0">-- Select Category --</option>
                    @foreach (var cat in Model)
                    {
                        <option value="@cat.Id" @(selectedCat == cat.Id ? "selected" : "")>
                            @cat.Name
                        </option>
                    }
                </select>
            </div>

            @if (TempData["CategoryId-err"] != null)
            {
                <span class="text-danger">@TempData["CategoryId-err"]</span>
            }
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Product Name</label>
            <input name="Name" value="@TempData["NameValue"]" class="form-control form-control-lg border-dark" placeholder="Enter product name" />

            @if (TempData["Name"] != null)
            {
                <span class="text-danger">@TempData["Name"]</span>
            }
            @if (TempData["Name-err"] != null)
            {
                <span class="text-danger">@TempData["Name-err"]</span>
            }
            @if (TempData["Name-length"] != null)
            {
                <span class="text-danger">@TempData["Name-length"]</span>
            }
        </div>
    </div>





    <!-- Description & Model -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Description</label>
            <textarea name="Description" class="form-control border-dark" rows="5" placeholder="Enter product description">@TempData["DescriptionValue"]</textarea>

            @if (TempData["Description"] != null)
            {
                <span class="text-danger">@TempData["Description"]</span>
            }
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Model</label>
            <input name="Model" value="@TempData["ModelValue"]" class="form-control border-dark" placeholder="Enter model" />

            @if (TempData["Model"] != null)
            {
                <span class="text-danger">@TempData["Model"]</span>
            }
            @if (TempData["Model-err"] != null)
            {
                <span class="text-danger">@TempData["Model-err"]</span>
            }
        </div>
    </div>




    <!-- Price & Stock -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Price (Pkr)</label>
            <input type="number" value="@TempData["PriceValue"]" name="Price" class="form-control border-dark" placeholder="Enter price" />
            @if (TempData["Price"] != null)
            {
                <span class="text-danger">@TempData["Price"]</span>
            }
            @if (TempData["Price-err"] != null)
            {
                <span class="text-danger">@TempData["Price-err"]</span>
            }
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Stock Quantity</label>
            <input type="number" value="@TempData["StockValue"]" name="Stock" class="form-control border-dark" placeholder="Enter stock quantity" />

            @if (TempData["Stock"] != null)
            {
                <span class="text-danger">@TempData["Stock"]</span>
            }
        </div>
    </div>




    <!-- Image & Status -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Product Image</label>
            <input name="Image" type="file" class="form-control border-dark" />
            <span class="text-danger">@TempData["Image"]</span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Stock Status</label>
            <select name="IsActive" class="form-select border-dark" required>
                <option value="true" class="text-success"
                        @(TempData["IsActive"] != null && (bool)TempData["IsActive"] ? "selected" : "")>
                    Active
                </option>
                <option value="false" class="text-danger"
                        @(TempData["IsActive"] != null && (bool)TempData["IsActive"] == false ? "selected" : "")>
                    Non Active
                </option>
            </select>
        </div>
    </div>

    

    
    <!-- Buttons -->
    <div class="d-flex justify-content-end mt-4">
        <button type="submit" class="btn btn-dark btn-lg me-2"><i class="fas fa-plus-circle me-1"></i>Add Product</button>
        <a class="btn btn-secondary btn-lg" href="@Url.Action("Product_Index", "Admin")"><i class="fas fa-arrow-left me-1"></i>Show Product</a>
    </div>



</form>