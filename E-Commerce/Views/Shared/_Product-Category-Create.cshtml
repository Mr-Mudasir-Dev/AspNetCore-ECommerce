<form method="post">

    <div class="border rounded p-4">
        <h6 class="fw-bold mb-2">Add New Category</h6>

        <p class="text-muted mb-4">
            Category name should contain only letters (A–Z).
            Numbers and special characters are not allowed.
        </p>

        
        <div class="mb-3">
            <label class="form-label">Category Name</label>
            <input type="text"
                   name="CategoryName"
                   class="form-control form-control-lg"
                   placeholder="Enter category name" />
            <span class="text-danger">@TempData["catnull"]</span>
            <span class="text-danger">@TempData["caterror"]</span>
        </div>

        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-control form-select form-control-lg">
                <option value="true" class="text-success">Active</option>
                <option value="false" class="text-danger">Non Active</option>
            </select>
        </div>


        <div class="d-grid mt-4">
            <button type="submit" class="btn btn-primary btn-lg">
                Create Category
            </button>
        </div>
    </div>

</form>