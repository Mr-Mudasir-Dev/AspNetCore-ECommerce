@{
    ViewData["Title"] = "Home Page";
}
@model Category

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Delete Category Confirmation</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <!-- Details -->
                <div class="col-md-8">
                    <h3 class="fw-bold"><strong>Category Name:</strong> @Model.Name</h3>
                    <p><strong>ID:</strong> @Model.Id</p>
                    <p><strong>Name:</strong> @Model.Name</p>
                    <p><strong>Status:</strong> @Model.Status</p>

                    <hr />
                    <p class="text-danger fw-bold">
                        If you delete this category, all related products will also be deleted. Are you sure?
                    </p>

                    <a class="btn btn-secondary"
                       asp-controller="Admin"
                       asp-action="Category_All_Show">
                        Back
                    </a>

                    <a class="btn btn-danger"
                       asp-controller="Admin"
                       asp-action="Category_Delete"
                       asp-route-id="@Model.Id">
                        Delete
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
