@model Product

<div class="container-fluid px-5 mt-5 mb-5">
    @await Html.PartialAsync("_Product-Edit-Msg") <!-- Form -->
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Header -->
        <div class="card-header bg-dark text-white rounded-top-4">
            <h4 class="mb-0">
                <i class="fas fa-box-open me-2"></i>Edit @Model.Name
            </h4>
            <p class="mb-0 small text-secondary">
                Fill all fields to edit product. Make sure the category exists.
            </p>
        </div>
        
        <!-- Body -->
        <div class="card-body p-4 bg-light">
            @await Html.PartialAsync("_Product-Edit") <!-- Form -->
        </div>
    </div>
</div>
