@model List<Product>
@await Html.PartialAsync("_Product-Index-Msg")


<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">All Product Record</h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped table-hover text-center align-middle w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Image</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @await Html.PartialAsync("_Product-Index")
                </tbody>
            </table>
        </div>
    </div>
</div>