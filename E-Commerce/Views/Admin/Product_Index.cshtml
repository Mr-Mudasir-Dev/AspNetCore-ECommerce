@model List<Product>

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">All Category Record</h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped table-hover text-center align-middle w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Image</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Price</td>
                            <td><img src="" alt="@p.Name" width="50px" /></td>
                            <td>
                                <a class="btn btn-sm btn-primary" asp-controller="Admin" asp-action="Category_Edit" asp-route-id="@p.Id">Edit</a>
                                <a class="btn btn-sm btn-danger" asp-controller="Admin" asp-action="Category_Delete_Permission" asp-route-id="@p.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>