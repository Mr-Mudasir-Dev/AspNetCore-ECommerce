@model List<Customer>

<div class="container-fluid mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mt-3" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
                <symbol id="check-circle-fill" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                </symbol>
            </svg>
            <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:"><use xlink:href="#check-circle-fill" /></svg>
            <div>
                @TempData["Success"]
            </div>
        </div>
    }
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">All Qustomers Record</h5>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped table-hover text-center align-middle w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Phone</td>
                            <td>
                                <a class="btn btn-sm btn-primary" asp-controller="" asp-action="" asp-route-id="@p.Id">Work In Soon</a>
                                <a class="btn btn-sm btn-warning" asp-controller="Admin" asp-action="Customer_Detail" asp-route-id="@p.Id">Detail</a>
                                <a class="btn btn-sm btn-danger" asp-controller="Admin" asp-action="Customer_Delete_Premission" asp-route-id="@p.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>