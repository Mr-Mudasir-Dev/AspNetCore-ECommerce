@{
    ViewData["Title"] = "Product Premission";
}
@model Customer

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Block Customer</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <!-- Details -->
                <div class="col-md-8">
                    <h3 class="fw-bold"><strong>Customer Name:</strong> @Model.Name</h3>
                    <p><strong>ID:</strong> @Model.Id</p>
                    <p><strong>Email:</strong> @Model.Email</p>

                    <hr />
                    <p class="text-danger fw-bold">
                        Are you sure you want to Block @Model.Name Customer?
                    </p>

                    <a class="btn btn-secondary"
                       asp-action="Qustomer_Index"
                       asp-controller="Admin">
                        Back
                    </a>

                    <a class="btn btn-danger"
                       asp-controller="Admin"
                       asp-action="Customer_Delete"
                       asp-route-id="@Model.Id">
                        Delete
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
