@model Customer

<div class="container-fluid mt-4 mb-5">
    <div class="card shadow">
        <div class="card-header bg-warning text-white">
            <h5 class="mb-0">@Model.Name - Detail</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <!-- Image -->
                <div class="col-md-4 text-center">
                    <img src="~/user/User-Image/@Model.Image"
                         class="img-fluid img-thumbnail shadow"
                         style="max-height:300px; object-fit:cover;"
                         alt="Product Image" />
                </div>

                <!-- Details -->
                <div class="col-md-8">
                    <h3 class="fw-bold">@Model.Name</h3>

                    <hr />

                    <h6>Customer Id:</h6>
                    <p>@Model.Id</p>

                    <hr />

                    <p class="text-muted mb-1">
                        Customer Name:
                        <strong>@Model.Name</strong>
                    </p>

                    <p class="text-muted mb-1">
                        Email:
                        <strong>@Model.Email</strong>
                    </p>

                    <hr />

                    <p class="text-muted mb-1">
                        Mobile Number:
                        <strong>@Model.Phone</strong>
                    </p>

                    <a class="btn btn-warning mt-3"
                       asp-controller="Admin"
                       asp-action="Qustomer_Index">
                        Back
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
